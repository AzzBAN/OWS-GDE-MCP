# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.eggs/
build/
dist/

# uv
.uv/
uv.lock.bak

# Env / secrets — NEVER commit
.env
.env.*
!.env.example
.secrets
*.pem
*.key

# opencode.json may carry forwarded env secrets — NEVER commit
opencode.json

# Playwright / discovery
.playwright-profile/
playwright-report/
test-results/
trace.zip

# Discovery dumps may contain sensitive request/response payloads.
# Commit only sanitized examples placed under docs/discovery/examples/.
docs/discovery/raw/
docs/discovery/scratch/
docs/discovery/*.har
docs/discovery/**/*.json
!docs/discovery/examples/**

# Real OWS app exports — contain proprietary business logic, possibly
# customer data. NEVER commit. Keep locally for the MCP to parse.
docs/discovery/**/sample-apps/
*.gpk
*.gpk.zip

# OWS knowledge vault — the per-project default is ./ows-vault (override with
# OWS_VAULT_DIR). AUTO-GENERATED parts are regenerable and NOT committed:
#   - Reference/   : imported OWS help corpus (scripts/import_help_corpus.py)
#   - .index/      : sidecar search index
#   - .obsidian/   : Obsidian workspace state
# The CURATED parts (ows-vault/Home.md, ows-vault/00 Findings/**) ARE tracked.
ows-vault/Reference/
ows-vault/.index/
ows-vault/.obsidian/
# Legacy flat HTML cache from scripts/fetch_help_docs.py.
docs/help/en_US/
!docs/help/.gitkeep

# Per-project finding vaults created by installed plugins elsewhere are the
# user's to manage; this only governs THIS repo's ows-vault.

# Skill runtime scratch — downloaded attachments / OCR temp. May contain
# customer data; never commit.
**/tmp_attachments/

# Playwright MCP per-session artifacts (snapshots, console logs).
.playwright-mcp/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Test artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Per-machine MCP server config (use .mcp.json.example as template).
# The absolute --project path differs per checkout, so keep it local.
.mcp.json
