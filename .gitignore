# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.eggs/
build/
dist/

# uv
.uv/
uv.lock.bak

# Env / secrets — NEVER commit
.env
.env.*
!.env.example
.secrets
*.pem
*.key

# Playwright / discovery
.playwright-profile/
playwright-report/
test-results/
trace.zip

# Discovery dumps may contain sensitive request/response payloads.
# Commit only sanitized examples placed under docs/discovery/examples/.
docs/discovery/raw/
docs/discovery/scratch/
docs/discovery/*.har
docs/discovery/**/*.json
!docs/discovery/examples/**

# Real OWS app exports — contain proprietary business logic, possibly
# customer data. NEVER commit. Keep locally for the MCP to parse.
docs/discovery/**/sample-apps/
*.gpk
*.gpk.zip

# OWS knowledge vault — AUTO-GENERATED parts are regenerable, not committed:
#   - the legacy flat HTML cache (scripts/fetch_help_docs.py)
#   - the imported Reference corpus + its sidecar search index
#     (scripts/import_help_corpus.py)
# The CURATED parts (docs/help/vault/Home.md, docs/help/vault/00 Findings/**)
# are git-tracked and intentionally NOT ignored.
docs/help/en_US/
docs/help/vault/Reference/
docs/help/vault/.obsidian/
docs/help/index/
!docs/help/.gitkeep

# Playwright MCP per-session artifacts (snapshots, console logs).
.playwright-mcp/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Test artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
