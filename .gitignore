# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.eggs/
build/
dist/

# uv
.uv/
uv.lock.bak

# Env / secrets — NEVER commit
.env
.env.*
!.env.example
.secrets
*.pem
*.key

# Playwright / discovery
.playwright-profile/
playwright-report/
test-results/
trace.zip

# Discovery dumps may contain sensitive request/response payloads.
# Commit only sanitized examples placed under docs/discovery/examples/.
docs/discovery/raw/
docs/discovery/scratch/
docs/discovery/*.har
docs/discovery/**/*.json
!docs/discovery/examples/**

# Real OWS app exports — contain proprietary business logic, possibly
# customer data. NEVER commit. Keep locally for the MCP to parse.
docs/discovery/**/sample-apps/
*.gpk
*.gpk.zip

# Local OWS help corpus cache — populated by `scripts/fetch_help_docs.py`.
# 50+ MB of static documentation HTML; not source-controlled.
docs/help/**/*.html
docs/help/**/*.json
docs/help/**/figure/
docs/help/**/public_sys-resources/
!docs/help/.gitkeep

# Playwright MCP per-session artifacts (snapshots, console logs).
.playwright-mcp/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Test artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
