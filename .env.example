# Copy to .env and fill in. .env is gitignored.

# --- Tenant × Surface base URLs ---
#
# OWS has two independent axes:
#
#   * Tenant — `prod` or `testbed`. Separate environments with their own
#     accounts and CAS servers.
#   * Surface — `studio` (design-time authoring) or `runtime` (deployed
#     apps for end users / preview / production traffic).
#
# Set whichever cells of the matrix you have access to. Typical workflow:
# author in testbed studio → preview on testbed runtime → deploy to prod
# runtime. Production usually has no developer-facing studio, so the
# `OWS_PROD_STUDIO_URL` slot is normally left blank. There is no fallback
# between surfaces — leaving a slot blank simply means tools that target
# that surface will refuse with a clear error.
#
# Note: on this discovery testbed the *same* host serves both surfaces.
# Set the same URL for both STUDIO_URL and RUNTIME_URL of that tenant.

OWS_TESTBED_STUDIO_URL=https://<your-tenant>-studio.example.com
OWS_TESTBED_RUNTIME_URL=https://<your-tenant>-studio.example.com

OWS_PROD_STUDIO_URL=
OWS_PROD_RUNTIME_URL=https://<your-tenant>.example.com

# --- Auth (per tenant) ---
# One CAS session covers BOTH surfaces of a tenant — you only need one
# cookie + CSRF pair per tenant, not per (tenant, surface).
#
# Two ways to authenticate. Pick one (or both — captured cookie is used first,
# auto-relogin kicks in only after the cookie expires).
#
# (1) Captured session cookie — paste the raw Cookie header from a logged-in
#     browser session. See README.md → "Capturing the session cookie".
#     Treat these like passwords. Never commit. Rotate when shared.
OWS_TESTBED_SESSION_COOKIE=
OWS_PROD_SESSION_COOKIE=

# CSRF token — `window.csrfToken` from the same logged-in session.
# Required for any non-GET (POST/PUT/DELETE) request.
OWS_TESTBED_CSRF_TOKEN=
OWS_PROD_CSRF_TOKEN=

# (2) Credentials for auto-relogin — when the captured cookie expires (or if
#     no cookie was set), the MCP runs a headless CAS login with these and
#     refreshes the in-memory cookie. Requires the `login` optional extra:
#         uv pip install -e '.[login]' && playwright install chromium
#     Leave blank to disable auto-relogin (you'll re-capture cookies manually).
#     If both surfaces are configured for a tenant, login uses the runtime
#     surface (CAS lives at the same host either way).
OWS_TESTBED_USERNAME=
OWS_TESTBED_PASSWORD=
OWS_PROD_USERNAME=
OWS_PROD_PASSWORD=

# --- Production safety ---
# Mutating tools refuse to run against prod unless this is "1".
# Even then, every prod-mutating tool requires confirm=true at call time.
OWS_PROD_WRITE_ENABLED=0

# --- MCP server transport ---
# stdio is default; set to "http" + PORT to run as Streamable HTTP server.
OWS_MCP_TRANSPORT=stdio
OWS_MCP_HTTP_PORT=8765
