# Copy to .env and fill in. .env is gitignored.

# --- Tenant base URLs ---
# Studio (design state) — where flows/forms/data/services are authored
OWS_TESTBED_STUDIO_URL=https://1057-sg-studio.teleows.com
OWS_PROD_STUDIO_URL=

# Runtime (deployed apps, work orders, alarms, SLA)
OWS_TESTBED_RUNTIME_URL=
OWS_PROD_RUNTIME_URL=https://1057-sg.teleows.com

# --- Auth ---
# Paste the raw Cookie header from a logged-in browser session.
# See README.md → "Capturing the session cookie" for step-by-step.
# Treat these like passwords — never commit, rotate when shared.
OWS_TESTBED_SESSION_COOKIE=
OWS_PROD_SESSION_COOKIE=

# CSRF token — `window.csrfToken` from the same logged-in session.
# Required for any non-GET (POST/PUT/DELETE) request.
OWS_TESTBED_CSRF_TOKEN=
OWS_PROD_CSRF_TOKEN=

# --- Production safety ---
# Mutating tools refuse to run against prod unless this is "1".
# Even then, every prod-mutating tool requires confirm=true at call time.
OWS_PROD_WRITE_ENABLED=0

# --- MCP server transport ---
# stdio is default; set to "http" + PORT to run as Streamable HTTP server.
OWS_MCP_TRANSPORT=stdio
OWS_MCP_HTTP_PORT=8765
